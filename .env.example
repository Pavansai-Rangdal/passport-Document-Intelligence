# Application Configuration
APP_NAME=Passport Document Intelligence
APP_VERSION=0.1.0
DEBUG=false
ENVIRONMENT=development

# Server
HOST=0.0.0.0
PORT=8000
WORKERS=1

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/passport_db
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# Redis
REDIS_URL=redis://localhost:6379/0

# Celery
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Storage
STORAGE_PATH=data/uploads
STORAGE_MAX_FILE_SIZE=10485760
STORAGE_ALLOWED_MIME_TYPES=image/jpeg,image/jpg,image/png,image/webp,application/pdf

# Retention
RETENTION_DAYS=90
RETENTION_AUDIT_DAYS=365

# OCR Configuration
OCR_ENGINE=both
OCR_CONFIDENCE_THRESHOLD=0.7

# Security
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
ENCRYPTION_KEY=change-me-in-production-use-openssl-rand-hex-32
MAX_UPLOAD_RATE=10
API_KEY_REQUIRED=false

# Verification
ENABLE_CHIP_AUTHENTICATION=false
ENABLE_LOST_STOLEN_CHECK=false
VERIFICATION_TIMEOUT_SECONDS=30

# Processing
BATCH_SIZE=50
PROCESSING_TIMEOUT_SECONDS=300

# Quality Thresholds
MIN_IMAGE_WIDTH=800
MIN_IMAGE_HEIGHT=600
MIN_DPI=150
MAX_BLUR_SCORE=100.0
MIN_BRIGHTNESS=50.0
MAX_BRIGHTNESS=200.0

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json
