# Application
APP_NAME=Passport Expiry Classifier
APP_VERSION=0.1.0
DEBUG=false
ENVIRONMENT=development

# Server
HOST=0.0.0.0
PORT=8888
FRONTEND_PORT=3000

# Uploads (frontend reads these too)
MAX_UPLOAD_MB=10
ALLOWED_UPLOAD_EXTENSIONS=.jpg,.jpeg,.png,.webp,.pdf
REQUEST_TIMEOUT_MS=600000

# OCR — primary: paddle, fallback: easyocr
OCR_ENGINE=paddle
OCR_CONFIDENCE_THRESHOLD=0.7

# Image Quality Thresholds
MIN_IMAGE_WIDTH=800
MIN_IMAGE_HEIGHT=600
MAX_BLUR_SCORE=100.0
MIN_BRIGHTNESS=50.0
MAX_BRIGHTNESS=200.0

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Laya local decision model (optional; leave empty to use the deterministic MRZ date check)
LAYA_CHECKPOINT_PATH=
